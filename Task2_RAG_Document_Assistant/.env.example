# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" - it is listed in .gitignore.

# ---------------------------------------------------------------------
# LLM  (gemini = real answers | mock = offline test mode, no API key)
# ---------------------------------------------------------------------
LLM_PROVIDER=gemini
# >>> PUT YOUR OWN GEMINI API KEY HERE (get one at https://aistudio.google.com/apikey) <<<
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0

# ---------------------------------------------------------------------
# Embeddings  (huggingface = real model | hash = offline test mode only)
# ---------------------------------------------------------------------
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------
# Chunking and retrieval
# ---------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
# Minimum cosine similarity for a passage to be used. Scores are NOT comparable
# between embedding models - re-tune this if you change EMBEDDING_MODEL.
RELEVANCE_THRESHOLD=0.25

# ---------------------------------------------------------------------
# Storage and limits (optional)
# ---------------------------------------------------------------------
# CHROMA_DIR=data/chroma_db
# UPLOAD_DIR=data/uploads
# COLLECTION_NAME=documents
# MAX_UPLOAD_MB=50
