# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# --- LLM (required to chat) -------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (e.g. a local server). Leave empty for OpenAI.
# OPENAI_BASE_URL=

# --- Web search -------------------------------------------------------------
# DuckDuckGo works with no key. If TAVILY_API_KEY is set, Tavily is tried first.
TAVILY_API_KEY=
# auto | duckduckgo | tavily
SEARCH_PROVIDER=auto

# --- Optional limits (defaults shown) ---------------------------------------
# WORKSPACE_DIR=workspace
# MAX_ITERATIONS=8
# MAX_TOOL_CALLS=12
# TOOL_TIMEOUT=30
# SEARCH_TIMEOUT=15
# LLM_TIMEOUT=60
# MAX_FILE_BYTES=100000
# MAX_OUTPUT_CHARS=8000
# MAX_SEARCH_RESULTS=5
# HISTORY_TURNS=10
# LOG_LEVEL=WARNING
