# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is listed in .gitignore).

# Required for real extraction. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional settings (the values below are the defaults)
GEMINI_MODEL=gemini-2.5-flash
LLM_MOCK_MODE=false
MAX_RETRIES=3
API_MAX_RETRIES=2
API_RETRY_DELAY=2.0
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
# OUTPUT_DIR=output
